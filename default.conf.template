server {
    listen 80;
    resolver 127.0.0.11 valid=30s;   # Docker-DNS, nodig omdat de proxy_pass variabelen bevat

    root /usr/share/nginx/html;
    index index.html;

    # Zoeken: alleen q wordt doorgegeven, de API-key wordt hier toegevoegd
    location = /api {
        proxy_pass http://spottarr:8383/newznab/api?t=search&apikey=${NEWZNAB_APIKEY}&q=$arg_q;
    }

    # Meest recente spots (zoeken zonder zoekterm)
    location = /recent {
        proxy_pass http://spottarr:8383/newznab/api?t=search&apikey=${NEWZNAB_APIKEY};
    }

    # NZB downloaden
    location = /nzb {
        proxy_pass http://spottarr:8383/newznab/api?t=get&apikey=${NEWZNAB_APIKEY}&guid=$arg_guid;
    }

    location / {
        try_files $uri /index.html;
    }
}
